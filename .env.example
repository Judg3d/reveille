# Optional. Leave blank when Dockhand authentication is disabled.
# Compose loads this file with env_file and passes DOCKHAND_API_TOKEN into the
# Reveille container. If your Dockhand deployment requires API auth, set the
# token here or through your deployment secret store. Do not commit a real token.
DOCKHAND_API_TOKEN=

# Image tag used by compose.yml. Common values are "latest", a release version
# like "v0.1.0", or a commit SHA tag if your registry publishes those.
REVEILLE_TAG=latest

# Recommended. Signs wait-page session tokens so in-flight wait sessions
# survive Reveille restarts. Any long random string works:
#   openssl rand -hex 32
REVEILLE_TOKEN_SECRET=

# Optional. When set, the Traefik forward-auth middleware must send this value
# as the X-Reveille-Auth header; other containers on the shared network cannot
# trigger starts. See docs/security.md for the Traefik wiring.
REVEILLE_FORWARD_AUTH_SECRET=

# Optional. Bearer token for the admin dashboard and its API when
# admin.listen is enabled in reveille.yml. Set it whenever other workloads
# share the Docker network.
REVEILLE_ADMIN_TOKEN=

# Optional notification credentials, referenced from reveille.yml with
# ${...} expansion (see the notify: section in reveille.example.yml).
#GOTIFY_TOKEN=
#TELEGRAM_BOT_TOKEN=
